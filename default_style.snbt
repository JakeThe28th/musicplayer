{
    default: {
        contains: [],
        properties: {
            left_margin: "4",
            right_margin: "4",
            top_margin: "4",
            bottom_margin: "4",
            max_width: "flex",
            min_width: "flex",
            max_height: "flex",
            min_height: "flex",
            horizontal_alignment: "left",
            vertical_alignment: "top",
        }
    },
	font_size: {
        properties: {
            size: "18",
        },
    },
	icon_size: {
        properties: {
            size: "28",
        },
    },
    gui_clear_color: {
        properties: {
            base_color: "#090909ff"
        }
    },
    accent_color: {
        properties: {
            base_color: "#1c73ff"
        }
    },
    dark_color: {
        properties: {
            base_color: "#2c2c2cff",
            outline_color: "#2c2c2cff"
        }
    },
    invisible: {
        properties: {
            base_color: "css_rgba(0,0,0,0)"
        }
    },
    hover: {
        properties: {
            outline_color: "css_rgba(0,0,0,0)"
        }
    },
    hover_main: {
        properties: {
            background_color: "#404040",
            outline_color: "#5d5d5dff",
            outline_size: "0"
        }
    },
    hoverable: {
        predicates: {
            "HOVERED=true": "hover_main"
        }
    },
	 boundable: {
        predicates: {
            "BOUNDED=true": "hover_main"
        }
    },
    text: {
        properties: {
            base_color: "#F0F0F0",
            outline_size: "0"
        },
        contains: ["font_size", "hoverable"]
    },
    grayed_text: {
        properties: {
            base_color: "#A0A0A0"
        },
        contains: ["font_size", "hoverable"]
    },
    icon: {
        properties: {
            base_color: "#F0F0F0",
            background_margin: "2"
        },
        contains: ["icon_size", "hoverable"]
    },
    home_screen_tab_text: {
        predicates: {
            "SELECTED=true": "text"
        },
        contains: ["grayed_text"]
    },
    home_screen_tabs: {
        properties: {
            horizontal_alignment: "middle",
            outline_margin: "0"
        }
    },
	home_screen_groups: {
	    contains: ["snowui-w_contained"]
    },
    settings_header_icons: {
        properties: {
            horizontal_alignment: "middle"
        }
    },
    setting_section_title: {
        contains: ["text"],
        properties: {
            vertical_alignment: "middle",
            horizontal_alignment: "middle",
            background_color: "css_rgba(0,0,0,0)"
        }
    },
    setting_section_icon: {
        contains: ["icon"],
        properties: {
            vertical_alignment: "middle",
            background_margin: "-2"
        }
    },
    setting_collapsible: {
        properties: {
            min_width: "container",
            max_width: "container"
        }
    },
    setting_list: {
        properties: {
            min_width: "container",
            max_width: "container"
        }
    },
    section_line: {
        properties: {
            min_width: "container",
            base_color: "#3A3A3A",
            size: "1"
        }
    },
    setting_key: {
        properties: {
            background_color: "css_rgba(0,0,0,0)"
        },
        contains: ["text"]
    },
    setting_boolean: {
        predicates: {
            "SELECTED=true": "accent_color"
        },
        properties: {
            outline_size: "1",
            outline_margin: "1",
            background_margin: "0"
        },
        contains: ["hoverable", "dark_color"]
    },
    slider: {
        properties: {
            size: "4",
        },
        contains: ["boundable", "dark_color"]
    },
	slider_handle: {
        properties: {
            size: "14",
        },
        contains: ["accent_color"]
    },
	scrollbar: {
        properties: {
            base_color: "css_rgba(255,255,255,.04)",
			left_margin: "12",
			right_margin: "12",
        }
    },
	scroll_handle: {
        properties: {
			left_margin: "5",
			right_margin: "5",
			size: "12",
        },
		contains: ["accent_color"]
    },
	playlist_group_title_elements: {
		properties: {
			horizontal_alignment: "middle",
		}
	}
}